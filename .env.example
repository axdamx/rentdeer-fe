# Supabase project settings
# Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used only by Supabase CLI commands such as `npm run db:types:linked`.
# Never expose the database password or a Supabase secret/service-role key to
# browser code or commit them to source control.
SUPABASE_PROJECT_ID=your-project-ref

# Public site URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
